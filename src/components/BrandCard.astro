---
import type { Airport } from '../data/airports';

export interface Props {
  airport: Airport;
}

const { airport } = Astro.props;
---
<article class="featured-card">
  <div class="brand-card-top">
    <img 
      src={`/images/brands/${airport.logo}?v=2`} 
      width="48" 
      height="48" 
      alt={airport.name} 
      class="brand-avatar-img large" 
      onerror="this.src='data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0OCIgaGVpZ2h0PSI0OCI+PHJlY3Qgd2lkdGg9IjEwMCUiIGhlaWdodD0iMTAwJSIgZmlsbD0iI2U0ZTlmMiIvPjwvc3ZnPg=='"
      loading="lazy"
      decoding="async"
    >
    <span class={airport.brandTag === '优先推荐' || airport.brandTag === '重点推荐' ? 'badge badge-primary' : 'badge'}>{airport.brandTag || '重点关注'}</span>
  </div>
  <h3>{airport.name}</h3>
  <p>{airport.brandDesc}</p>
  <div class="price-promo-box">
    <div class="price-item">
      <span>最低价格</span>
      <strong>{airport.price}<small>/月付</small></strong>
    </div>
    <div class="promo-item">
      <span>专属优惠码</span>
      <div class="promo-code-group">
        <code>{airport.code}</code>
        <button class="copy-code-btn" data-code={airport.code} title="点击一键复制">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
        </button>
      </div>
    </div>
  </div>
  <div class="card-actions">
    <a class="button" style="width: 100%; justify-content: center;" href={airport.link} target="_blank" rel="nofollow sponsored noopener noreferrer">官网注册 <span>↗</span></a>
  </div>
</article>
