---
import type { Airport } from '../data/airports';

export interface Props {
  airport: Airport;
}

const { airport } = Astro.props;
---
<a href={`/jichang/${airport.reviewId || airport.id}/`} class="review-card-special" style="display: block; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px 20px; text-decoration: none; transition: all 0.3s ease; grid-column: 1 / -1; margin-bottom: 8px;">
  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px;">
    <div style="display: flex; align-items: center; gap: 12px;">
      <img src={`/images/brands/${airport.logo}?v=2`} width="36" height="36" alt={airport.name} style="border-radius: 8px; object-fit: cover; box-shadow: 0 2px 6px rgba(0,0,0,0.05);" onerror="this.style.display='none'" loading="lazy" decoding="async">
      <h3 style="font-size: 1.1rem; color: #0f172a; margin: 0; font-weight: 700; line-height: 1.3;">{airport.reviewTitle || `[测评] ${airport.name}机场`}</h3>
    </div>
    <div style="background: #eff4ff; color: #2563eb; font-size: 0.75rem; font-weight: 700; padding: 4px 10px; border-radius: 12px; border: 1px solid #bfdbfe; white-space: nowrap; margin-left: 12px;">{airport.reviewTag || '🔥 本站测评'}</div>
  </div>
  <p style="font-size: 0.9rem; color: #475569; line-height: 1.5; margin: 0 0 10px 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">{airport.reviewDesc}</p>
  <span style="font-size: 0.85rem; font-weight: 700; color: #2563eb; display: flex; align-items: center; gap: 4px;">立即阅读完整报告 <span>→</span></span>
</a>
