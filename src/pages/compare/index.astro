const allAirports = [...top7, ...others];
---
<BaseLayout 
  title="36家主力机场横向对比表 - 价格与线路全景图｜机场狗" 
  description="市场上本站36家主力机场横向对比表。按价格、专线类型、优惠码全面呈现，帮您最快锁定高性价比翻墙节点。"
>
  <section class="page-shell compare-section" style="padding-top: 100px; padding-bottom: 80px;">
    <div class="section-heading" style="margin-bottom: 56px; justify-content: center; text-align: center;">
      <div style="width: 100%; text-align: center;">
        <p class="eyebrow" style="margin-bottom: 12px; display: inline-block;">Premium Compare</p>
        <br/>
        <h1 style="font-size: 2.75rem; margin: 0; background: linear-gradient(135deg, var(--ink) 0%, var(--blue) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; display: inline-block; font-weight: 800; letter-spacing: -1px;">36 家机场综合对比表</h1>
        <p style="margin-top: 20px; color: var(--muted); font-size: 1.15rem; max-width: 600px; margin-left: auto; margin-right: auto;">按性价比与线路质量进行综合排列。全景展现最低价格、节点类型及本站优惠优惠，助您快速锁定心仪品牌。</p>
      </div>
    </div>
    
    <div class="table-container">
      <table class="compare-table">
        <thead>
          <tr>
            <th>综合排名</th>
            <th class="align-left">品牌名称</th>
            <th>最低月付</th>
            <th>线路类型</th>
            <th>专属优惠码</th>
            <th>官网直达</th>
          </tr>
        </thead>
        <tbody>
          {allAirports.map((airport, index) => (
            <tr class={index < 3 ? 'top-3-tier' : (index < 7 ? 'top-tier' : '')}>
              <td class="rank-col">
                {index === 0 ? <div class="medal medal-1">🥇 <span>TOP 1</span></div> : 
                 index === 1 ? <div class="medal medal-2">🥈 <span>TOP 2</span></div> : 
                 index === 2 ? <div class="medal medal-3">🥉 <span>TOP 3</span></div> : 
                 <div class="rank-num">{index + 1}</div>}
              </td>
              <td class="brand-name align-left">
                <div class="brand-cell">
                  <img 
                    src={`/images/brands/${airport.logo}?v=2`} 
                    alt={`${airport.name} logo`} 
                    loading="lazy"
                    width="44"
                    height="44"
                    style="width: 44px; height: 44px; min-width: 44px; border-radius: 12px; object-fit: cover; box-shadow: 0 4px 10px rgba(0,0,0,0.06);"
                    onerror="this.src='data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0OCIgaGVpZ2h0PSI0OCI+PHJlY3Qgd2lkdGg9IjEwMCUiIGhlaWdodD0iMTAwJSIgZmlsbD0iI2U0ZTlmMiIvPjwvc3ZnPg=='"
                  />
                  <strong>{airport.name}</strong>
                </div>
              </td>
              <td class="price-col">
                <span class="price-val">{airport.price}</span>
                <span class="price-unit">/月起</span>
              </td>
              <td class="type-col">
                <span class="badge badge-iplc">
                  <i></i> {airport.type}
                </span>
              </td>
              <td class="code-col">
                <div class="promo-code-wrapper">
                  <code>{airport.code}</code>
                  <button class="copy-code-btn" data-code={airport.code} title="点击复制" aria-label="复制优惠码">
                    <svg style="width: 16px; height: 16px; min-width: 16px; flex-shrink: 0;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                  </button>
                </div>
              </td>
              <td class="action-col">
                <a href={airport.link} target="_blank" rel="nofollow sponsored noopener noreferrer" class="direct-link-btn">
                  官网 
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
  
  <style>
    .compare-section {
      max-width: 1100px;
      margin: 0 auto;
    }

    /* 容器设计：剔除常规表格线，使用阴影与卡片缝隙 */
    .table-container {
      width: 100%;
      max-width: 100%;
      min-width: 0;
      margin-top: 32px;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 24px;
    }
    
    .compare-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0 12px;
      text-align: center;
      min-width: 900px;
    }
    
    /* 普通表头，取消吸附 */
    .compare-table th {
      padding: 16px 20px;
      font-weight: 700;
      color: #64748b;
      white-space: nowrap;
      font-size: 0.9rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      background: #f8fafc;
      border-bottom: 2px solid #e2e8f0;
    }
    
    /* 每一行都是一个独立的悬浮卡片 */
    .compare-table td {
      padding: 16px 20px;
      vertical-align: middle;
      background: #ffffff;
      border-top: 1px solid #f1f5f9;
      border-bottom: 1px solid #f1f5f9;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    /* 左右两端圆角闭合 */
    .compare-table td:first-child {
      border-left: 1px solid #f1f5f9;
      border-top-left-radius: 16px;
      border-bottom-left-radius: 16px;
    }
    .compare-table td:last-child {
      border-right: 1px solid #f1f5f9;
      border-top-right-radius: 16px;
      border-bottom-right-radius: 16px;
    }
    
    /* 悬浮微动效：向上浮动+发光阴影 */
    .compare-table tbody tr {
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      box-shadow: 0 4px 6px -1px rgba(0,0,0,0.02);
    }
    .compare-table tbody tr:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 24px -10px rgba(14, 165, 233, 0.15);
    }
    
    /* 梯队高亮背景 */
    .top-tier td { background: #f8fafc; }
    .top-3-tier td { background: #f0fdfa; border-color: #ccfbf1; }
    
    /* 排名徽章设计 */
    .rank-col { width: 100px; }
    .medal {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 6px 14px;
      border-radius: 20px;
      font-size: 0.9rem;
      font-weight: 800;
      box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    }
    .medal span { font-size: 0.75rem; letter-spacing: 0.5px; opacity: 0.9; }
    .medal-1 { background: linear-gradient(135deg, #fde047, #eab308); color: #713f12; }
    .medal-2 { background: linear-gradient(135deg, #e2e8f0, #cbd5e1); color: #334155; }
    .medal-3 { background: linear-gradient(135deg, #ffedd5, #fdba74); color: #9a3412; }
    
    .rank-num {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      background: #f1f5f9;
      border-radius: 50%;
      color: #64748b;
      font-weight: 700;
      font-size: 0.9rem;
    }
    
    /* 品牌图标与名称 */
    .align-left { text-align: left; }
    .brand-cell {
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .brand-cell img {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      object-fit: cover;
      box-shadow: 0 4px 10px rgba(0,0,0,0.06);
    }
    .brand-cell strong {
      font-size: 1.15rem;
      color: var(--ink);
      font-weight: 800;
    }
    
    /* 价格排版 */
    .price-col { min-width: 120px; }
    .price-val { color: var(--ink); font-weight: 800; font-size: 1.25rem; }
    .price-unit { color: #94a3b8; font-size: 0.8rem; font-weight: 600; margin-left: 2px; }
    
    /* 线路类型药丸标签 */
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 14px;
      border-radius: 20px;
      font-size: 0.85rem;
      font-weight: 700;
    }
    .badge-iplc {
      background: rgba(16, 185, 129, 0.1);
      color: #059669;
    }
    .badge-iplc i {
      display: inline-block;
      width: 6px; height: 6px;
      border-radius: 50%;
      background: #10b981;
      box-shadow: 0 0 8px #34d399;
    }
    
    /* 极简优惠码组件 */
    .code-col { min-width: 160px; }
    .promo-code-wrapper {
      display: inline-flex;
      align-items: center;
      background: #f8fafc;
      border: 1px dashed #cbd5e1;
      border-radius: 8px;
      overflow: hidden;
      transition: border-color 0.2s;
    }
    .promo-code-wrapper:hover {
      border-color: var(--blue);
      border-style: solid;
    }
    .promo-code-wrapper code {
      padding: 8px 12px;
      font-size: 0.9rem;
      color: #0f172a;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-weight: 700;
    }
    .promo-code-wrapper button {
      background: transparent;
      border: none;
      border-left: 1px solid #e2e8f0;
      padding: 8px 12px;
      cursor: pointer;
      color: #64748b;
      display: flex;
      align-items: center;
      transition: all 0.2s;
    }
    .promo-code-wrapper button:hover {
      background: var(--blue);
      color: #fff;
      border-left-color: var(--blue);
    }
    
    /* 直达按钮 */
    .action-col { width: 140px; }
    .direct-link-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      background: var(--ink);
      color: #fff;
      padding: 10px 20px;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 700;
      font-size: 0.95rem;
      transition: all 0.2s;
      box-shadow: 0 4px 12px rgba(15, 23, 42, 0.15);
    }
    .direct-link-btn:hover {
      background: var(--blue);
      transform: translateY(-1px);
      box-shadow: 0 6px 16px rgba(14, 165, 233, 0.3);
    }

    @media (max-width: 768px) {
      .compare-section {
        width: 100%;
        min-width: 0;
      }

      .table-container {
        margin-top: 20px;
      }

      .compare-table th,
      .compare-table td {
        padding: 12px 14px;
      }
    }
  </style>
</BaseLayout>
