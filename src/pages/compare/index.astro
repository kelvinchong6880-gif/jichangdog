const allAirports = [...top7, ...others];
---
<BaseLayout 
  title="36家主力机场横向对比表 - 价格与线路全景图｜机场狗" 
  description="全网独家36家主力机场横向对比表。按价格、专线类型、优惠码全面呈现，帮您最快锁定高性价比翻墙节点。"
>
  <section class="page-shell home-section" style="padding-top: 120px;">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Data Compare</p>
        <h1 style="font-size: 2.5rem; margin: 0; background: linear-gradient(135deg, var(--blue) 0%, #0ea5e9 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; display: inline-block;">36 家机场综合对比表</h1>
        <p style="margin-top: 16px; color: var(--muted); font-size: 1.1rem;">按性价比与线路质量进行综合排列，帮助您快速决策。</p>
      </div>
    </div>
    
    <div class="table-container">
      <table class="compare-table">
        <thead>
          <tr>
            <th>排名</th>
            <th>品牌名称</th>
            <th>最低月付</th>
            <th>线路类型</th>
            <th>专属优惠码</th>
            <th>直达链接</th>
          </tr>
        </thead>
        <tbody>
          {allAirports.map((airport, index) => (
            <tr class={index < 7 ? 'top-tier' : ''}>
              <td class="rank-col">
                {index === 0 ? <span class="medal medal-1">🥇 1</span> : 
                 index === 1 ? <span class="medal medal-2">🥈 2</span> : 
                 index === 2 ? <span class="medal medal-3">🥉 3</span> : 
                 <span class="rank-num">{index + 1}</span>}
              </td>
              <td class="brand-name"><strong>{airport.name}</strong></td>
              <td class="price-col">{airport.price}</td>
              <td class="type-col"><span class="badge badge-iplc">{airport.type}</span></td>
              <td class="code-col">
                <div class="promo-code-group" style="margin: 0 auto; display: inline-flex;">
                  <code>{airport.code}</code>
                  <button class="copy-code-btn" data-code={airport.code} title="点击复制">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                  </button>
                </div>
              </td>
              <td class="action-col">
                <a href={airport.link} target="_blank" rel="noopener" class="button button-small" style="font-weight: 600;">官网直达 <span>↗</span></a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
  
  <style>
    .table-container {
      margin-top: 48px;
      overflow-x: auto;
      background: #fff;
      border-radius: 16px;
      border: 1px solid var(--line);
      box-shadow: 0 10px 30px -10px rgba(0,0,0,0.05);
    }
    
    .compare-table {
      width: 100%;
      border-collapse: collapse;
      text-align: center;
      min-width: 800px;
    }
    
    .compare-table th {
      background: #f8fafc;
      padding: 18px 20px;
      font-weight: 700;
      color: var(--ink);
      border-bottom: 2px solid var(--line);
      white-space: nowrap;
      font-size: 0.95rem;
    }
    
    .compare-table td {
      padding: 20px;
      border-bottom: 1px solid var(--line);
      vertical-align: middle;
      transition: background-color 0.2s;
    }
    
    .compare-table tr:last-child td {
      border-bottom: none;
    }
    
    .compare-table tr:hover td {
      background: #f8fafc;
    }
    
    .top-tier td {
      background: #f0f9ff;
    }
    .compare-table tr.top-tier:hover td {
      background: #e0f2fe;
    }
    
    .rank-col { font-weight: 700; }
    .medal { padding: 4px 10px; border-radius: 20px; font-size: 0.9rem; }
    .medal-1 { background: #fef08a; color: #854d0e; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
    .medal-2 { background: #e2e8f0; color: #475569; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
    .medal-3 { background: #fed7aa; color: #9a3412; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
    .rank-num { color: #64748b; font-size: 1.1rem; }
    
    .brand-name strong { font-size: 1.1rem; color: var(--ink); }
    .price-col { color: #0369a1; font-weight: 800; font-size: 1.1rem; }
    
    .badge {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 600;
    }
    .badge-iplc {
      background: #dcfce7;
      color: #166534;
      border: 1px solid #bbf7d0;
    }
    
    .promo-code-group {
      display: inline-flex;
      align-items: center;
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 6px;
      overflow: hidden;
    }
    .promo-code-group code {
      padding: 6px 12px;
      font-size: 0.85rem;
      color: #0f172a;
      border-right: 1px solid var(--line);
      font-weight: 600;
    }
    .promo-code-group button {
      background: #f8fafc;
      border: none;
      padding: 6px 10px;
      cursor: pointer;
      color: #64748b;
      display: flex;
      align-items: center;
      transition: all 0.2s;
    }
    .promo-code-group button:hover {
      background: #e2e8f0;
      color: var(--blue);
    }
    .promo-code-group button.copied {
      color: #10b981;
    }
  </style>
</BaseLayout>
