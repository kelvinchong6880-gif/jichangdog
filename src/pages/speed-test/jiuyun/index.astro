    .prose tbody tr:hover { background: #f1f5f9; }
    .toc-sidebar { width: 300px; flex-shrink: 0; position: sticky; top: 120px; }
    .toc-container { background: #fff; padding: 28px; border-radius: 16px; box-shadow: 0 4px 24px rgba(0,0,0,0.05); border: 1px solid rgba(0,0,0,0.05); }
    .toc-title { font-size: 1.15rem; font-weight: 800; color: var(--ink); margin-bottom: 20px; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
    .toc-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px; }
    .toc-link { color: var(--muted); text-decoration: none; font-size: 0.95rem; transition: all 0.2s; display: block; line-height: 1.5; border-left: 2px solid transparent; padding-left: 12px; margin-left: 2px; }
    .toc-link:hover, .toc-link.active { color: var(--blue); font-weight: 700; border-left-color: var(--blue); }
    @media (max-width: 992px) {
      .knowledge-layout { flex-direction: column; padding-top: 100px; }
      .toc-sidebar { display: none; }
      .article-content { padding: 32px 24px; border-radius: 12px; }
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const content = document.querySelector('.article-content');
      const tocList = document.getElementById('toc-list');
      if (!content || !tocList) return;

      const headings = content.querySelectorAll('h2, h3');
      
      headings.forEach((heading) => {
        if(!heading.id) return;
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = '#' + heading.id;
        a.textContent = heading.textContent;
        a.className = 'toc-link';
        if(heading.tagName.toLowerCase() === 'h3') {
           a.style.paddingLeft = '24px';
           a.style.fontSize = '0.9rem';
        }
        li.appendChild(a);
        tocList.appendChild(li);
      });

      const observerOptions = {
        root: null,
        rootMargin: '-100px 0px -60% 0px',
        threshold: 0
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            document.querySelectorAll('.toc-link').forEach(link => {
              link.classList.remove('active');
              if (link.getAttribute('href') === '#' + id) {
                link.classList.add('active');
              }
            });
          }
        });
      }, observerOptions);

      headings.forEach(heading => observer.observe(heading));
    });
  </script>
