    .prose table { width: 100%; border-collapse: collapse; font-size: 1.05rem; }
    .prose th, .prose td { border-bottom: 1px solid #e2e8f0; padding: 18px 24px; text-align: left; }
    .prose th { background: #f8fafc; color: #0f172a; font-weight: 700; border-bottom: 2px solid #cbd5e1; }
    .prose tbody tr:last-child td { border-bottom: none; }
