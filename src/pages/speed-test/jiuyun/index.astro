    .prose .lead-paragraph { font-size: 1.15rem; color: #374151; background: #f0fdf4; border-left: 4px solid #10b981; padding: 24px; margin-bottom: 36px; border-radius: 0 8px 8px 0; line-height: 1.8; }
    .prose h2 { font-size: 1.7rem; color: var(--blue); margin-top: 64px; margin-bottom: 28px; border-bottom: 2px solid #eff4ff; padding-bottom: 12px; font-weight: 700; }
