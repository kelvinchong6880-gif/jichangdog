            <table style="width: 100%; border-collapse: collapse; font-size: 1.05rem;">
              <thead>
                <tr>
                  <th style="background: #f8fafc; padding: 18px 24px; text-align: left; border-bottom: 2px solid #fca5a5; color: #991b1b;">核心 IEPL 极客节点</th>
                  <th style="background: #f8fafc; padding: 18px 24px; text-align: left; border-bottom: 2px solid #fca5a5; color: #991b1b;">晚高峰网络延迟 (Ping)</th>
                  <th style="background: #f8fafc; padding: 18px 24px; text-align: left; border-bottom: 2px solid #fca5a5; color: #991b1b;">大并发 TCP 丢包率</th>
                  <th style="background: #f8fafc; padding: 18px 24px; text-align: left; border-bottom: 2px solid #fca5a5; color: #991b1b;">千兆宽带下行吞吐</th>
                </tr>
              </thead>
              <tbody>
                <tr style="border-bottom: 1px solid #fef2f2;">
                  <td style="padding: 18px 24px;">🇭🇰 广港 IEPL 流媒体原生线</td>
