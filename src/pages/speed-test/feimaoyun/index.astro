      max-width: 1200px;
      margin: 0 auto;
      align-items: flex-start;
    }
    .article-content {
      flex: 1;
      min-width: 0;
      background: #fff;
      padding: 48px;
      border-radius: 20px;
      box-shadow: 0 4px 24px rgba(0,0,0,0.04);
    }
    
    .prose h1 { font-size: 2.2rem; color: var(--ink); line-height: 1.4; margin-bottom: 28px; }
    .prose .lead-paragraph { font-size: 1.1rem; color: #374151; background: #f0fdf4; border-left: 4px solid #10b981; padding: 20px 24px; margin-bottom: 36px; border-radius: 0 8px 8px 0; line-height: 1.7; }
    .prose h2 { font-size: 1.6rem; color: var(--blue); margin-top: 56px; margin-bottom: 24px; border-bottom: 2px solid #eff4ff; padding-bottom: 12px; }
    .prose h3 { font-size: 1.3rem; color: #1f2937; margin-top: 36px; margin-bottom: 18px; }
    .prose p { font-size: 1.05rem; line-height: 1.8; color: #4b5563; margin-bottom: 20px; }
    .prose a { color: var(--blue); text-decoration: none; font-weight: 600; }
    .prose a:hover { text-decoration: underline; }
    .prose ul, .prose ol { margin-bottom: 24px; padding-left: 28px; font-size: 1.05rem; line-height: 1.8; color: #4b5563; }
    .prose ul li, .prose ol li { margin-bottom: 12px; }
    .prose code { background: #f3f4f6; color: #ef4444; padding: 3px 8px; border-radius: 6px; font-size: 0.9em; font-family: monospace; display: inline-block;}
    
    .table-responsive { overflow-x: auto; margin-bottom: 40px; margin-top: 24px; border-radius: 12px; border: 1px solid #e5e7eb; box-shadow: 0 2px 8px rgba(0,0,0,0.02); }
    .prose table { width: 100%; border-collapse: collapse; font-size: 1rem; }
    .prose th, .prose td { border-bottom: 1px solid #e5e7eb; padding: 16px 20px; text-align: left; }
    .prose th { background: #f8fafc; color: #1e293b; font-weight: 700; border-bottom: 2px solid #e2e8f0; }
    .prose tbody tr:last-child td { border-bottom: none; }
    .prose tbody tr:nth-child(even) { background: #fcfcfc; }
    .prose tbody tr:hover { background: #f1f5f9; }
    
    .faq-item { background: #fcfcfc; border: 1px solid #f3f4f6; border-radius: 12px; padding: 24px; margin-bottom: 24px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02); }
    .faq-item h3 { color: var(--blue); font-size: 1.15rem; margin-top: 0; margin-bottom: 12px; display: flex; align-items: flex-start; gap: 8px; }
    .faq-item p { margin-bottom: 0; color: #4b5563; line-height: 1.7; }
    
    .toc-sidebar { width: 280px; flex-shrink: 0; position: sticky; top: 120px; }
    .toc-container { background: #fff; padding: 24px; border-radius: 16px; box-shadow: 0 4px 24px rgba(0,0,0,0.04); border: 1px solid rgba(0,0,0,0.05); }
    .toc-title { font-size: 1.1rem; font-weight: 700; color: var(--ink); margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--line); }
    .toc-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px; }
    .toc-link { color: var(--muted); text-decoration: none; font-size: 0.95rem; transition: all 0.2s; display: block; line-height: 1.5; border-left: 2px solid transparent; padding-left: 10px; margin-left: 2px; }
    .toc-link:hover, .toc-link.active { color: var(--blue); font-weight: 600; border-left-color: var(--blue); }

    @media (max-width: 992px) {
      .knowledge-layout { flex-direction: column; padding-top: 100px; }
      .toc-sidebar { display: none; }
      .article-content { padding: 24px; border-radius: 12px; }
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const content = document.querySelector('.article-content');
      const tocList = document.getElementById('toc-list');
      if (!content || !tocList) return;

      const headings = content.querySelectorAll('h2, h3');
      
      headings.forEach((heading) => {
        if(!heading.id) return;
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = '#' + heading.id;
        a.textContent = heading.textContent;
        a.className = 'toc-link';
        if(heading.tagName.toLowerCase() === 'h3') {
           a.style.paddingLeft = '20px';
           a.style.fontSize = '0.85rem';
        }
        li.appendChild(a);
        tocList.appendChild(li);
      });

      const observerOptions = {
        root: null,
        rootMargin: '-100px 0px -60% 0px',
        threshold: 0
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            document.querySelectorAll('.toc-link').forEach(link => {
              link.classList.remove('active');
              if (link.getAttribute('href') === '#' + id) {
                link.classList.add('active');
              }
            });
          }
        });
      }, observerOptions);

      headings.forEach(heading => observer.observe(heading));
    });
  </script>
</BaseLayout>
