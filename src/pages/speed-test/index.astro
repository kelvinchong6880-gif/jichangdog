---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SpeedTestCard from '../../components/SpeedTestCard.astro';
import { allAirports } from '../../data/airports';

const speedAirports = allAirports.filter(a => a.speedId || a.speedTitle || a.speedDesc);
---
<BaseLayout title="机场测速 | 真实晚高峰测速报告与评测" description="机场狗整理各类翻墙机场的节点测速记录，涵盖截图所示的延迟、流媒体访问与速度数据，帮助您结合测试条件比较不同网络服务。">
  <section class="page-shell home-section" style="padding-top: 120px; padding-bottom: 80px; min-height: 70vh;">
    <div class="section-heading">
      <div>
        <p class="eyebrow">数据说话</p>
        <h1 style="font-size: 2.5rem; margin: 0; color: var(--ink);">机场晚高峰测速</h1>
      </div>
      <p style="color: var(--muted); margin-top: 16px; font-size: 1.1rem; max-width: 600px;">
        我们坚持在最拥堵的晚高峰进行网络测速，用最真实的数据揭示各大机场的抗压能力，拒绝虚假宣传。
      </p>
    </div>
    
    <div class="articles-grid">
      {speedAirports.map(airport => (
        <SpeedTestCard airport={airport} headingLevel="h2" />
      ))}
    </div>
  </section>
</BaseLayout>
