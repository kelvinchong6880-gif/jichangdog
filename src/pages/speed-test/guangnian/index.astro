    .prose-guangnian h2 { font-size: 1.7rem; color: #312e81; margin-top: 56px; margin-bottom: 24px; border-bottom: 2px solid #e0e7ff; padding-bottom: 12px; font-weight: 800; }
    .prose-guangnian h3 { font-size: 1.35rem; color: #3730a3; margin-top: 36px; margin-bottom: 16px; font-weight: 700; }
    .prose-guangnian p { font-size: 1.1rem; line-height: 1.85; color: #475569; margin-bottom: 24px; }
    .prose-guangnian a { color: #4f46e5; text-decoration: none; font-weight: 600; }
    .prose-guangnian a:hover { text-decoration: underline; }
    .prose-guangnian ul { margin-bottom: 24px; padding-left: 24px; }
    .prose-guangnian ul li { margin-bottom: 12px; font-size: 1.05rem; line-height: 1.7; color: #475569; }
    
    .faq-item { background: #f8fafc; border: 1px solid #e2e8f0; border-left: 4px solid #4f46e5; border-radius: 8px; padding: 24px; margin-bottom: 24px; transition: all 0.2s; }
    .faq-item h3 { margin: 0 0 12px 0; font-size: 1.15rem; font-weight: 800; color: #1e1b4b; display: flex; align-items: flex-start; gap: 8px; line-height: 1.5; }
    .faq-item p { margin: 0; font-size: 1.05rem; color: #475569; line-height: 1.7; }
    
    .toc-sidebar { width: 300px; flex-shrink: 0; position: sticky; top: 120px; }
    .toc-container { background: #fff; padding: 28px; border-radius: 16px; box-shadow: 0 4px 24px rgba(0,0,0,0.05); border: 1px solid rgba(0,0,0,0.05); }
    .toc-title { font-size: 1.15rem; font-weight: 800; color: #1e1b4b; margin-bottom: 20px; padding-bottom: 14px; border-bottom: 1px solid #e0e7ff; }
    .toc-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px; }
    .toc-link { color: #64748b; text-decoration: none; font-size: 0.95rem; transition: all 0.2s; display: block; line-height: 1.5; border-left: 3px solid transparent; padding-left: 12px; }
    .toc-link:hover, .toc-link.active { color: #312e81; font-weight: 700; border-left-color: #4f46e5; background: #eef2ff; padding: 6px 12px 6px 9px; border-radius: 0 6px 6px 0; }

    @media (max-width: 992px) {
      .knowledge-layout { flex-direction: column; padding-top: 100px; }
      .toc-sidebar { display: none; }
      .article-content { padding: 32px 24px; }
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const content = document.querySelector('.article-content');
      const tocList = document.getElementById('toc-list');
      if (!content || !tocList) return;

      const headings = content.querySelectorAll('h2, h3');
      
      headings.forEach((heading) => {
        if(!heading.id) {
          heading.id = 'h-' + Math.random().toString(36).substring(2, 11);
        }
        
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = '#' + heading.id;
        a.textContent = heading.textContent;
        a.className = 'toc-link';
        if(heading.tagName.toLowerCase() === 'h3') {
           a.style.paddingLeft = '24px';
           a.style.fontSize = '0.9rem';
        }
        li.appendChild(a);
        tocList.appendChild(li);
      });

      const observerOptions = { root: null, rootMargin: '-100px 0px -60% 0px', threshold: 0 };
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            document.querySelectorAll('.toc-link').forEach(link => {
              link.classList.remove('active');
              if (link.getAttribute('href') === '#' + id) {
                link.classList.add('active');
              }
            });
          }
        });
      }, observerOptions);

      headings.forEach(heading => observer.observe(heading));

    });
  </script>
</BaseLayout>
