      background: #fcfcfc;
    }

    /* FAQ Styles */
    .faq-item {
      background: #fcfcfc;
      border: 1px solid #f3f4f6;
      border-radius: 12px;
      padding: 24px;
      margin-bottom: 24px;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02);
    }
    .faq-item h3 {
      color: var(--blue);
      font-size: 1.15rem;
      margin-top: 0;
      margin-bottom: 12px;
      display: flex;
      align-items: flex-start;
      gap: 8px;
    }
    .faq-item p {
      margin-bottom: 0;
      color: #4b5563;
      line-height: 1.7;
    }
    
    /* TOC Sidebar Styles */
    .toc-sidebar {
      width: 280px;
