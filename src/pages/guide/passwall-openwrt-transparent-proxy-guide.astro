import BaseLayout from '../../layouts/BaseLayout.astro';
const title = "PassWall 详细配置指南：打造全家极速透明翻墙环境";
const description = "深度剖析 OpenWrt PassWall 插件下载与透明代理设置！教你切换 Sing-box 核心、配置 ChinaDNS-NG 防泄漏，彻底解决国内网站打不开与游戏 NAT 痛点。";
