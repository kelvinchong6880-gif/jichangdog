const title = "Spotify 跨区注册与 Premium 家庭组购买防封指南";
const description = "Spotify 用了 14 天被强制退出？解密 14 天漫游限制与家庭组地址验证风控。教你 2026 最新低价区 Premium 合租防掉车技巧，并无损迁移网易云歌单。";
