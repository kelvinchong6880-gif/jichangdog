      padding-bottom: 8px;
    }
    .prose h3 {
      font-size: 1.25rem;
      color: #1f2937;
      margin-top: 32px;
      margin-bottom: 16px;
    }
    .prose p {
      font-size: 1rem;
      line-height: 1.8;
      color: #4b5563;
      margin-bottom: 20px;
    }
    .prose a {
      color: var(--blue);
      text-decoration: none;
      font-weight: 600;
    }
    .prose a:hover {
      text-decoration: underline;
    }
    .prose ul {
      margin-bottom: 24px;
      padding-left: 24px;
    }
    .prose ul li {
