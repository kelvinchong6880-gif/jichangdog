  </article>

  <style>
    .knowledge-layout {
      display: flex;
      gap: 40px;
      padding-top: 140px;
      padding-bottom: 80px;
      max-width: 1200px;
      margin: 0 auto;
      align-items: flex-start;
    }
    .article-content {
      flex: 1;
      min-width: 0;
      background: #fff;
      padding: 40px;
      border-radius: 16px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.03);
    }
    
    /* Typography / Prose Styles */
    .prose h1 {
      font-size: 2rem;
      color: var(--ink);
      line-height: 1.4;
      margin-bottom: 24px;
    }
    .prose .lead-paragraph {
      font-size: 1.1rem;
      color: #374151;
      background: #eff6ff;
      border-left: 4px solid #3b82f6;
