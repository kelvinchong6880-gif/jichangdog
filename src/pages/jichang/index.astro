---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import { allAirports } from '../../data/airports';

// Filter airports that have review data
const reviewAirports = allAirports.filter(a => a.reviewId || a.reviewTitle || a.reviewDesc);
---

<BaseLayout 
  title="全部37家机场品牌推荐｜机场狗" 
  description="机场狗机场测评库整理37家服务商的套餐价格、线路类型、节点覆盖、设备限制和风险提示，并提供对应测速记录与详细评测入口。"
>
  <section class="page-shell home-section" style="padding-top: 120px;">
    <div class="section-heading">
      <div>
        <p class="eyebrow">测评档案</p>
        <h1 style="font-size: 2.5rem; margin: 0; background: linear-gradient(135deg, var(--blue) 0%, #0ea5e9 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; display: inline-block;">37家机场测评报告</h1>
      </div>
    </div>
    
    <div class="featured-grid" style="display: flex; flex-direction: column; gap: 8px;">
      {reviewAirports.map(airport => (
        <ReviewCard airport={airport} />
      ))}
    </div>
  </section>
</BaseLayout>
