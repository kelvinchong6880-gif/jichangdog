  <style>
    .knowledge-layout {
      display: flex;
      gap: 40px;
      padding-top: 140px;
      padding-bottom: 80px;
      max-width: 1200px;
      margin: 0 auto;
      align-items: flex-start;
    }
    .article-content {
      flex: 1;
      min-width: 0;
      background: #fff;
      padding: 40px;
      border-radius: 16px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.03);
    }
    
    .prose h1 { font-size: 2rem; color: var(--ink); line-height: 1.4; margin-bottom: 24px; }
    .prose .lead-paragraph { font-size: 1.1rem; color: #374151; background: #fdf2f8; border-left: 4px solid #db2777; padding: 16px 20px; margin-bottom: 32px; border-radius: 0 8px 8px 0; line-height: 1.6; }
    .prose h2 { font-size: 1.5rem; color: var(--blue); margin-top: 48px; margin-bottom: 20px; border-bottom: 2px solid #eff4ff; padding-bottom: 8px; }
