  </article>

  <style>
    .knowledge-layout {
      display: flex;
      gap: 40px;
      padding-top: 140px;
      padding-bottom: 80px;
      max-width: 1200px;
      margin: 0 auto;
      align-items: flex-start;
    }
    .article-content {
      flex: 1;
      min-width: 0; /* prevent overflow */
      background: #fff;
      padding: 40px;
      border-radius: 16px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.03);
    }
    
    /* Typography / Prose Styles */
    .prose h1 {
