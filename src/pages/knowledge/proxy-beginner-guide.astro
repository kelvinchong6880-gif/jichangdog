      line-height: 1.4;
      margin-bottom: 24px;
    }
    .prose .lead-paragraph {
      font-size: 1.1rem;
      color: #374151;
      background: #f0fdf4;
      border-left: 4px solid #10b981;
      padding: 16px 20px;
      margin-bottom: 32px;
      border-radius: 0 8px 8px 0;
      line-height: 1.6;
    }
    .prose h2 {
      font-size: 1.5rem;
      color: var(--blue);
      margin-top: 48px;
      margin-bottom: 20px;
      border-bottom: 2px solid #eff4ff;
      padding-bottom: 8px;
    }
    .prose h3 {
      font-size: 1.25rem;
      color: #1f2937;
      margin-top: 32px;
      margin-bottom: 16px;
    }
